# Copiar este archivo a .env.local para desarrollo local,
# o configurar estas mismas variables en AWS Amplify (App settings > Environment variables).

# Único punto de entrada hacia los 5 microservicios (producción).
# Rutas disponibles (rutas desnudas, sin stage ni prefijo):
#   /juegos/*        -> Catálogo
#   /editoriales/*   -> Catálogo
#   /partidas/*      -> Partidas
#   /clientes/*      -> Membresías y reservas
#   /perfil          -> Perfil de jugador (y /perfil/lista)
#   /analitica/*     -> Analítica / Athena
VITE_API_GATEWAY_URL=https://gd2m5wlwsh.execute-api.us-east-1.amazonaws.com

# Opcional: para desarrollo local puedes sobreescribir un microservicio puntual
# (por ejemplo, apuntar solo la analítica a un backend en localhost). Si no se
# definen, TODO sale por el gateway.
# VITE_CATALOGO_URL=http://localhost:8001
# VITE_PARTIDAS_URL=http://localhost:8002
# VITE_MEMBRESIAS_URL=http://localhost:8003
# VITE_PERFIL_URL=http://localhost:8004
# VITE_ANALITICA_URL=http://localhost:8005