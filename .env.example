# Copiar este archivo a .env.local para desarrollo local,
# o configurar estas mismas variables en AWS Amplify (App settings > Environment variables).

# "true" = usa datos mock (para trabajar sin backend listo)
# "false" = llama a los microservicios reales en las URLs de abajo
VITE_USE_MOCKS=true

# MS1 - Catálogo de juegos de mesa (Python/MySQL, puerto 8001)
VITE_CATALOGO_URL=http://localhost:8001

# MS2 - Partidas jugadas (Java/PostgreSQL, puerto 8002)
VITE_PARTIDAS_URL=http://localhost:8002

# MS3 - Membresías y reservas (Node.js/MongoDB, puerto 8003)
VITE_MEMBRESIAS_URL=http://localhost:8003

# MS4 - Perfil de jugador, agregador (puerto 8004)
VITE_PERFIL_URL=http://localhost:8004

# MS5 - Analítico / Athena (puerto 8005)
VITE_ANALITICA_URL=http://localhost:8005
